{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "types": ["astro/client"],
    "paths": {
      "@components/*": ["./src/components/*"],
      "@styles/*": ["./src/styles/*"],
      "@services/*": ["./src/services/*"],
      "@libs/*": ["./src/libs/*"],
      "@models/*": ["./src/models/*"],
      "@i18n/*": ["./src/i18n/*"],
      "@converters/*": ["./src/components/converter/*"]
    }
  }
}
