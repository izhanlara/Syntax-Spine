---
import type { HeaderModel } from "../../model/header";

const headerItems: HeaderModel[] = [];

function Header() {
  return (
    <nav>
      <ul>
        for (const item  of headerItems) {
          <li>{item}</li>
        }
      </ul>
    </nav>
  );
}

