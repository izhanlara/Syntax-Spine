---
import type { HeaderModel } from "../../model/header";

function Header({ Inicio, Portfolio, Contact }: HeaderModel) {
  return (
    <nav>
      <ul>
        for (const [key, value] of Object.entries({ Inicio, Portfolio, Contact })) {
          if (value) {
            <li>
              <a href={value}>{key}</a>
            </li>;
          }
        }
      </ul>
    </nav>
  );
}
