---
const menuItems = [
  { name: 'Inicio', href: '/' },
  { name: 'Portfolio', href: 'https://izhanlara.com', target: "_blank", rel: "noopener noreferrer" },
  { name: 'Acerca de', href: '/about' },
];
---
<nav class="c-header">
  <ul class="c-header__menu">
    {menuItems.map((item) => (
      <li class="c-header__menu-item"><a href={item.href} target={item.target} rel={item.rel}>{item.name}</a></li>
    ))}
  </ul>
</nav>