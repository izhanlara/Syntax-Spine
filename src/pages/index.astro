---
import "../styles/global.scss";
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Syntax Spine</title>
  </head>
  <body>
    <main class="layout">
      <section class="hero" aria-labelledby="hero-title">
        <p class="hero__eyebrow">Syntax & Spine</p>
