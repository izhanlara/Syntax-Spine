---
import type { Props } from '@models/props';
import { getUI } from '../../i18n/ui';
import BookCard from './BookCard.astro';

const { lang, books, errorMessage = null } = Astro.props as Props;
const ui = getUI(lang);
---

<section class="books">
  <div class="books__header">
    <h2 class="books__title">{ui.books.title}</h2>
    <p class="books__subtitle">{ui.books.subtitle}</p>
  </div>

  {errorMessage && (
    <p class="books__state books__state--error" role="alert">{errorMessage}</p>
  )}

  {!errorMessage && books.length === 0 && (
    <p class="books__state">{ui.books.empty}</p>
  )}

  {!errorMessage && books.length > 0 && (
    <ul class="books__grid" aria-label={ui.books.listAriaLabel}>
      {books.map((book) => (
        <li class="books__grid-item">
          <BookCard lang={lang} book={book} />
        </li>
      ))}
    </ul>
  )}
</section>
